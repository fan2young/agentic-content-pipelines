{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-direction-proof.schema.json",
  "type": "object",
  "required": ["schemaVersion", "status", "brandReferencesSha256", "frames", "comparison", "checks", "approvedBy", "approvedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["draft", "approved"]},
    "brandReferencesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frames": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["role", "path"],
        "properties": {"role": {"enum": ["opening", "core-mechanism", "close"]}, "path": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "comparison": {
      "type": "object", "required": ["palette", "typography", "logo", "materialLanguage", "density", "motionGrammar", "deviationReason"],
      "properties": {
        "palette": {"type": "string", "minLength": 8}, "typography": {"type": "string", "minLength": 8},
        "logo": {"type": "string", "minLength": 8}, "materialLanguage": {"type": "string", "minLength": 8},
        "density": {"type": "string", "minLength": 8}, "motionGrammar": {"type": "string", "minLength": 8},
        "deviationReason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object", "required": ["recentEpisodesCompared", "warmPaperInkRedDefault", "completeLockupPresent", "editorialMaterialLanguage", "redAxisHasMeaning", "noGenericAiTheme"],
      "properties": {
        "recentEpisodesCompared": {"const": true}, "warmPaperInkRedDefault": {"type": "boolean"},
        "completeLockupPresent": {"const": true}, "editorialMaterialLanguage": {"const": true},
        "redAxisHasMeaning": {"const": true}, "noGenericAiTheme": {"const": true}
      },
      "additionalProperties": false
    },
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "minLength": 8}
  },
  "additionalProperties": false
}
