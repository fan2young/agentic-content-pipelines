{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "captions.schema.json",
  "type": "object", "required": ["version", "audio", "duration", "captions"],
  "properties": {
    "version": {"const": 1}, "audio": {"type": "string", "minLength": 1}, "duration": {"type": "number", "minimum": 0},
    "captions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "start", "end", "text"], "properties": {
      "id": {"type": "string", "minLength": 1}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}, "text": {"type": "string", "minLength": 1}
    }, "additionalProperties": true}}
  }, "additionalProperties": true
}
