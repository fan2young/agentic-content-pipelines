{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-preflight-report.schema.json",
  "type": "object",
  "required": ["schemaVersion", "status", "createdAt", "runtime", "delivery", "checks", "actionableExceptions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["ready", "failed"]},
    "createdAt": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["ffmpeg", "ffprobe", "videoEncoder"],
      "properties": {
        "ffmpeg": {"$ref": "#/$defs/binary"},
        "ffprobe": {"$ref": "#/$defs/binary"},
        "videoEncoder": {"enum": ["libx264", "h264_videotoolbox"]}
      },
      "additionalProperties": false
    },
    "delivery": {"type": "object"},
    "checks": {"type": "array", "minItems": 1},
    "actionableExceptions": {"type": "array"}
  },
  "$defs": {
    "binary": {
      "type": "object",
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
